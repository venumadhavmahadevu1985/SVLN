#!/bin/sh
# Release gate: nothing is pushed to any branch (stage or prod) unless every test passes locally.
# Enabled once per clone with:  git config core.hooksPath .githooks
set -e
cd "$(git rev-parse --show-toplevel)"

echo "pre-push: 1/3 syntax check of the site's JavaScript"
for f in docs/js/*.js; do
  node --input-type=module --check < "$f" || { echo "pre-push: syntax error in $f — push refused."; exit 1; }
done
node --check docs/sw.js

echo "pre-push: 2/3 full test suite (unit, desktop and phone end-to-end)"
if ! npx playwright test --reporter=dot; then
  echo "pre-push: tests failed — push refused. Fix them, then push again."
  exit 1
fi

echo "pre-push: 3/3 Firestore security-rules tests"
if command -v java >/dev/null 2>&1; then
  npm run test:rules || { echo "pre-push: security-rules tests failed — push refused."; exit 1; }
else
  echo "pre-push: Java not installed here, so the rules tests run on GitHub before anything is deployed."
fi

echo "pre-push: all checks passed."
