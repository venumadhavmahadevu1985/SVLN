rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function role() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role;
    }

    // Receipts: members can view, admins can upload images/PDFs up to 5 MB.
    match /receipts/{file} {
      allow read: if request.auth != null && role() in ['admin', 'resident'];
      allow create: if request.auth != null && role() == 'admin'
        && request.resource.size < 5 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/pdf');
      allow delete: if request.auth != null && role() == 'admin';
    }
  }
}
