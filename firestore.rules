rules_version = '2';

// Roles live in users/{uid}.role: 'pending' (just signed up), 'resident', or 'admin'.
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function profile() { return get(/databases/$(db)/documents/users/$(request.auth.uid)).data; }
    function hasProfile() { return signedIn() && exists(/databases/$(db)/documents/users/$(request.auth.uid)); }
    function isAdmin() { return hasProfile() && profile().role == 'admin'; }
    function isMember() { return hasProfile() && profile().role in ['admin', 'resident']; }
    function isMyFlat(flatId) { return isMember() && profile().flatId == flatId; }
    function changedOnly(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }

    match /users/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      // New sign-ups can only create their own profile, as 'pending', without a flat.
      // Exception: on an empty database (no public/info yet) the first person becomes admin and sets the society up.
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email', 'name', 'role', 'createdAt'])
        && (request.resource.data.role == 'pending'
            || (request.resource.data.role == 'admin' && !exists(/databases/$(db)/documents/public/info)));
      // While pending, they may say which flat they live in (the admin still has to approve it).
      allow update: if isAdmin()
        || (signedIn() && request.auth.uid == uid && resource.data.role == 'pending'
            && changedOnly(['requestedFlat', 'name', 'phone']));
      allow delete: if isAdmin();
    }

    // Flats: everyone sees flat numbers and owner names; a resident may change only their own owner name.
    match /flats/{id} {
      allow read: if isMember();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (isMyFlat(id) && changedOnly(['owner', 'updatedAt', 'updatedBy']));
    }

    // Private flat details (phones, family, vehicles): only that flat's residents and admins.
    match /flatProfiles/{id} {
      allow read: if isAdmin() || isMyFlat(id);
      allow create, update: if isAdmin() || (isMyFlat(id) && request.resource.data.keys().hasOnly([
        'occupancy', 'residentName', 'phone', 'altPhone', 'email', 'members', 'vehicles',
        'emergencyName', 'emergencyPhone', 'family', 'taxAssessmentNo', 'taxDoc', 'taxPaid', 'taxOwnerName', 'taxAmount',
        'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
        && (!('family' in request.resource.data)
            || (request.resource.data.family is list && request.resource.data.family.size() <= 20))
        && (!('taxAssessmentNo' in request.resource.data)
            || (request.resource.data.taxAssessmentNo is string && request.resource.data.taxAssessmentNo.size() <= 40))
        && (!('taxPaid' in request.resource.data) || request.resource.data.taxPaid is map)
        && (!('taxOwnerName' in request.resource.data)
            || (request.resource.data.taxOwnerName is string && request.resource.data.taxOwnerName.size() <= 100))
        && (!('taxAmount' in request.resource.data)
            || (request.resource.data.taxAmount is number && request.resource.data.taxAmount >= 0 && request.resource.data.taxAmount <= 1000000)));
      allow delete: if isAdmin();
    }

    // House tax bill / receipt for a flat (a photo or PDF saved as text, under 1 MB): same privacy as flat details.
    match /taxDocs/{id} {
      allow read, delete: if isAdmin() || isMyFlat(id);
      allow create, update: if (isAdmin() || isMyFlat(id))
        && request.resource.data.keys().hasOnly(['name', 'type', 'data', 'updatedAt', 'updatedBy'])
        && request.resource.data.data is string && request.resource.data.data.size() < 1000000;
    }

    // Society name + address for the sign-in page (readable before sign-in).
    match /public/{id} { allow read: if true; allow write: if isAdmin(); }

    // Shared accounts: every approved member can read, only admins can change.
    match /expenses/{id} { allow read: if isMember(); allow write: if isAdmin(); }
    match /vendors/{id}  { allow read: if isMember(); allow write: if isAdmin(); }
    match /notices/{id}  { allow read: if isMember(); allow write: if isAdmin(); }
    match /meta/{id}     { allow read: if isMember(); allow write: if isAdmin(); }

    // Residents see only their own flat's payments; monthly totals are in meta/collections.
    match /payments/{id} {
      allow read: if isAdmin() || (isMember() && resource.data.flatId == profile().flatId);
      allow write: if isAdmin();
    }

    // Who is online: members see each other; each keeps only their own entry, stamped with the
    // server time and matching their real role and flat.
    match /presence/{uid} {
      allow read: if isMember();
      allow create, update: if isMember() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'role', 'flatId', 'online', 'lastSeen'])
        && request.resource.data.lastSeen == request.time
        && request.resource.data.online is bool
        && request.resource.data.name is string && request.resource.data.name.size() <= 100
        && request.resource.data.role == profile().role
        && request.resource.data.get('flatId', null) == profile().get('flatId', null);
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == uid);
    }

    // Usage log: members add their own app opens and taps; only admins can read or clear them.
    match /visits/{id} {
      allow read, delete: if isAdmin();
      allow create: if isMember() && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'name', 'flatId', 'role', 'at', 'device', 'installed', 'lang', 'screen'])
        && request.resource.data.at is string;
      allow update: if false;
    }
    match /clicks/{id} {
      allow read, delete: if isAdmin();
      allow create: if isMember() && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'name', 'flatId', 'role', 'at', 'events'])
        && request.resource.data.at is string
        && request.resource.data.events is list && request.resource.data.events.size() <= 100;
      allow update: if false;
    }

    // Append-only activity log.
    match /auditLog/{id} {
      allow read: if isAdmin();
      allow create: if isMember() && request.resource.data.by == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
